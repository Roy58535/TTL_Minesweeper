int currentDisplayGrid[8][8] = { 0 };
//int currentCursorPos[2] = {0};

int gridCoord[8][8][2];

void setupDisplay() {
  for (int i = 0; i < 8; i++) {
	for (int j = 0; j < 8; j++) {
	  gridCoord[i][j][0] = GRID_TOP_LEFT_X + j * GRID_CELL_SIZE;
	  gridCoord[i][j][1] = GRID_TOP_LEFT_Y + i * GRID_CELL_SIZE;
	}
  }

  static bool firstTime = true;
  if (firstTime) {
	tft.begin();
	tft.fillScreen(ILI9341_BLACK);
	tft.setRotation(1);
	firstTime = false;
  }

  tft.setTextColor(ILI9341_WHITE);
  tft.setTextSize(3);
  tft.setCursor(10, 10);
  tft.println("Minesweeper 8x8");

  displayFlagButton();
  displayOpenButton();
  
  tft.drawRect(GRID_TOP_LEFT_X - 1, GRID_TOP_LEFT_Y - 1, GRID_SIZE * GRID_CELL_SIZE + 2, GRID_SIZE * GRID_CELL_SIZE + 2, ILI9341_WHITE);
  for (int i = 0; i < GRID_SIZE; i++) {
	for (int j = 0; j < GRID_SIZE; j++) {
	  currentDisplayGrid[i][j] = EMPTY_DISPLAYED;	
	  tft.drawRect(gridCoord[i][j][0], gridCoord[i][j][1], GRID_CELL_SIZE, GRID_CELL_SIZE, ILI9341_WHITE);
	  displayNotOpened(i, j);
	}
  }

  displayCursor(0, 0);
  
}

void displayTimer(int32_t time) {
  //tft.fillRect(10, 40, 100, 14, ILI9341_BLACK);
  tft.setCursor(10, 40);
  tft.setTextSize(2);
  tft.setTextColor(ILI9341_WHITE, ILI9341_BLACK);
  double timeInSeconds = time / 1000.0;
  tft.println(timeInSeconds, 1);
}

void displayFlagButton() {
  tft.drawRect(FLAG_BUTTON_X, FLAG_BUTTON_Y, 48, 48, ILI9341_WHITE);
  tft.fillRect(FLAG_BUTTON_X + 1, FLAG_BUTTON_Y + 1, 46, 46, ILI9341_LIGHTGREY);
  tft.drawBitmap(FLAG_BUTTON_X + 1, FLAG_BUTTON_Y + 1, flagIcon, 46, 46, ILI9341_RED);
}

void displayOpenButton() {
  tft.drawRect(OPEN_BUTTON_X, OPEN_BUTTON_Y, 48, 48, ILI9341_WHITE);
  tft.fillCircle(OPEN_BUTTON_X + 24, OPEN_BUTTON_Y + 24, 16, ILI9341_RED);
}

void displayNumber(int row, int col, int num) {
  
  if (num >= 0 && num <= 8 && currentDisplayGrid[row][col] != num) {
	resetCell(row, col);
	currentDisplayGrid[row][col] = num;
	switch (num) {
	  case 0:
		break;
	  case 1:
		tft.drawBitmap(gridCoord[row][col][0] + 1, gridCoord[row][col][1] + 1, num1, 14, 14, NUM_COLORS[num - 1]);
		break;
	  case 2:
		tft.drawBitmap(gridCoord[row][col][0] + 1, gridCoord[row][col][1] + 1, num2, 14, 14, NUM_COLORS[num - 1]);
		break;
	  case 3:
		tft.drawBitmap(gridCoord[row][col][0] + 1, gridCoord[row][col][1] + 1, num3, 14, 14, NUM_COLORS[num - 1]);
		break;
	  case 4:
		tft.drawBitmap(gridCoord[row][col][0] + 1, gridCoord[row][col][1] + 1, num4, 14, 14, NUM_COLORS[num - 1]);
		break;
	  case 5:
		tft.drawBitmap(gridCoord[row][col][0] + 1, gridCoord[row][col][1] + 1, num5, 14, 14, NUM_COLORS[num - 1]);
		break;
	  case 6:
		tft.drawBitmap(gridCoord[row][col][0] + 1, gridCoord[row][col][1] + 1, num6, 14, 14, NUM_COLORS[num - 1]);
		break;
	  case 7:
		tft.drawBitmap(gridCoord[row][col][0] + 1, gridCoord[row][col][1] + 1, num7, 14, 14, NUM_COLORS[num - 1]);
		break;
	  case 8:
		tft.drawBitmap(gridCoord[row][col][0] + 1, gridCoord[row][col][1] + 1, num8, 14, 14, NUM_COLORS[num - 1]);
		break;
	  default:
		break;
	}
  }
}

void displayMine(int row, int col) {
  if (currentDisplayGrid[row][col] != MINE_DISPLAYED) {
	resetCell(row, col);
	tft.drawBitmap(gridCoord[row][col][0] + 1, gridCoord[row][col][1] + 1, mine, 14, 14, ILI9341_RED);
	Serial.println("Displayed mine at (" + String(row) + ", " + String(col) + ")");
	//tft.fillCircle(gridCoord[row][col][0] + 8, gridCoord[row][col][1] + 8, 4, ILI9341_RED);
	currentDisplayGrid[row][col] = MINE_DISPLAYED;
  }
}

void displayFlag(int row, int col) {
  if (currentDisplayGrid[row][col] != FLAG_DISPLAYED) {
	resetCell(row, col);
	tft.fillRect(gridCoord[row][col][0] + 1, gridCoord[row][col][1] + 1, 14, 14, ILI9341_LIGHTGREY);
	tft.drawBitmap(gridCoord[row][col][0] + 1, gridCoord[row][col][1] + 1, flag, 14, 14, ILI9341_RED);
	//tft.fillRect(gridCoord[row][col][0] + 4, gridCoord[row][col][1] + 4, 8, 8, ILI9341_PINK);
	currentDisplayGrid[row][col] = FLAG_DISPLAYED;
  }
}

void displayNotOpened(int row, int col) {
  if (currentDisplayGrid[row][col] != NOT_OPENED_DISPLAYED) {
	resetCell(row, col);
	tft.fillRect(gridCoord[row][col][0] + 1, gridCoord[row][col][1] + 1, 14, 14, ILI9341_LIGHTGREY);
	currentDisplayGrid[row][col] = NOT_OPENED_DISPLAYED;
  }
}

void displayCursor(int row, int col) {
  tft.drawRect(gridCoord[row][col][0], gridCoord[row][col][1], GRID_CELL_SIZE, GRID_CELL_SIZE, ILI9341_GREEN);
}

void deleteCursor(int row, int col) {
  tft.drawRect(gridCoord[row][col][0], gridCoord[row][col][1], GRID_CELL_SIZE, GRID_CELL_SIZE, ILI9341_WHITE);
}

void moveCursor(int prevRow, int prevCol, int newRow, int newCol) {
  deleteCursor(prevRow, prevCol);
  displayCursor(newRow, newCol);
}

void resetCell(int row, int col) {
  tft.fillRect(gridCoord[row][col][0] + 1, gridCoord[row][col][1] + 1, 14, 14, ILI9341_DARKGREY);
}

void displayWin() {
  
  tft.setCursor(100, 100);
  tft.setTextSize(3);
  tft.setTextColor(ILI9341_GREEN);
  tft.println("You Win!");
}

void displayLoss() {
  
  tft.setCursor(100, 100);
  tft.setTextSize(3);
  tft.setTextColor(ILI9341_RED);
  tft.println("Game Over!");
}